# Copy to .env for local development. Never commit real values.

# Local dev ports: web (Vite, hot module reload) and API (node --watch auto-restart).
# Vite proxies /api/* to the API port, so the browser only ever hits WEB_PORT.
WEB_PORT=3337
PORT=4337
NODE_ENV=development

# Docker only: set to true if hot reload misses file changes (e.g. some Windows/WSL setups)
VITE_USE_POLLING=false

# Future: Google sign-in (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Future: nearby restaurant suggestions
GOOGLE_MAPS_API_KEY=
YELP_API_KEY=
